#!/bin/bash
# Pre-commit hook for HyperRAM Memory Controller
# This hook runs before each commit to check code quality

set -e

# Color codes for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

echo "🔍 Running pre-commit checks..."

# ============================================================================
# Check if committing directly to main branch (BLOCKED!)
# ============================================================================
CURRENT_BRANCH=$(git symbolic-ref --short HEAD 2>/dev/null || echo "")

if [ "$CURRENT_BRANCH" = "main" ] && [ -z "$ALLOW_MAIN_COMMIT" ]; then
    echo ""
    echo "========================================"
    echo -e "${RED}❌ COMMIT TO MAIN BLOCKED!${NC}"
    echo "========================================"
    echo ""
    echo "You cannot commit directly to the main branch."
    echo ""
    echo "📋 Correct workflow:"
    echo "  1. Create a feature branch:"
    echo "     git checkout -b feature/your-feature"
    echo ""
    echo "  2. Make your changes and commit to the feature branch"
    echo ""
    echo "  3. Push feature branch:"
    echo "     git push origin feature/your-feature"
    echo ""
    echo "  4. Create a Pull Request on GitHub"
    echo ""
    echo "  5. After PR approval and merge, pull the changes:"
    echo "     git checkout main"
    echo "     git pull origin main"
    echo ""
    echo "🚫 Direct commits to main are not allowed."
    echo "   This enforces code review and CI checks."
    echo ""
    echo "ℹ️  For releases, use the release script:"
    echo "   ./scripts/create-public-release.sh"
    echo "   (The script will handle main branch updates automatically)"
    echo ""
    echo "⚠️  To bypass (NOT RECOMMENDED):"
    echo "   git commit --no-verify"
    echo ""
    exit 1
fi

# Get list of staged files (excluding example_design/, sim/, and testbench/ directories)
# Exception: ONLY testbench/tb_top.* at root level ARE checked (not in example_design/)
# Note: example_design/ contains Radiant/Propel generated files (including any tb_top.* in subfolders)
#       sim/ contains simulation scripts and prebuilt libraries
#       testbench/ contains testbench files and models (except root testbench/tb_top.*)
STAGED_V_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(v|sv|vh|svh)$' | grep -v '^example_design/' | grep -v '^sim/' | { grep -v '^testbench/' || true; } | cat)
# Only include testbench/tb_top.* at root level (anchored with ^)
STAGED_V_FILES_TB_TOP=$(git diff --cached --name-only --diff-filter=ACM | grep -E '^testbench/tb_top\.(v|sv)$' || true)
STAGED_V_FILES="$STAGED_V_FILES"$'\n'"$STAGED_V_FILES_TB_TOP"

STAGED_XML_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '\.xml$' | grep -v '^example_design/' | grep -v '^sim/' | grep -v '^testbench/' || true)
STAGED_PY_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '\.py$' | grep -v '^example_design/' | grep -v '^sim/' | grep -v '^testbench/' || true)

# Remove empty lines
STAGED_V_FILES=$(echo "$STAGED_V_FILES" | sed '/^$/d')

# Exit early if no relevant files (after exclusions)
if [ -z "$STAGED_V_FILES" ] && [ -z "$STAGED_XML_FILES" ] && [ -z "$STAGED_PY_FILES" ]; then
    echo -e "${GREEN}✓ No files to check (example_design/, sim/, testbench/ excluded except tb_top.*)${NC}"
    exit 0
fi

# Track if any checks failed
FAILED=0

# ============================================================================
# Check 1: Trailing Whitespace
# ============================================================================
echo ""
echo "📝 Checking for trailing whitespace..."
for file in $STAGED_V_FILES $STAGED_XML_FILES $STAGED_PY_FILES; do
    if [ -f "$file" ]; then
        if grep -qn '[[:space:]]$' "$file"; then
            echo -e "${RED}✗ Trailing whitespace found in: $file${NC}"
            grep -n '[[:space:]]$' "$file" | head -5
            FAILED=1
        fi
    fi
done

if [ $FAILED -eq 0 ]; then
    echo -e "${GREEN}✓ No trailing whitespace${NC}"
fi

# ============================================================================
# Check 2: Tab Characters (should use spaces)
# ============================================================================
echo ""
echo "📝 Checking for tab characters..."
TAB_FAILED=0
for file in $STAGED_V_FILES $STAGED_XML_FILES $STAGED_PY_FILES; do
    if [ -f "$file" ]; then
        if grep -qP '\t' "$file"; then
            echo -e "${RED}✗ Tab characters found in: $file (use spaces)${NC}"
            TAB_FAILED=1
            FAILED=1
        fi
    fi
done

if [ $TAB_FAILED -eq 0 ]; then
    echo -e "${GREEN}✓ No tab characters (spaces used correctly)${NC}"
fi

# ============================================================================
# Check 3: File Encoding (UTF-8)
# ============================================================================
echo ""
echo "📝 Checking file encoding..."
ENCODING_FAILED=0
for file in $STAGED_V_FILES $STAGED_XML_FILES $STAGED_PY_FILES; do
    if [ -f "$file" ]; then
        if command -v file &> /dev/null; then
            encoding=$(file -b --mime-encoding "$file")
            if [[ ! "$encoding" =~ ^(us-ascii|utf-8)$ ]]; then
                echo -e "${RED}✗ Non-UTF-8 encoding in: $file (found: $encoding)${NC}"
                ENCODING_FAILED=1
                FAILED=1
            fi
        fi
    fi
done

if [ $ENCODING_FAILED -eq 0 ]; then
    echo -e "${GREEN}✓ All files are UTF-8 or ASCII${NC}"
fi

# ============================================================================
# Check 4: Line Endings (LF not CRLF)
# ============================================================================
echo ""
echo "📝 Checking line endings (should be LF)..."
CRLF_FAILED=0
for file in $STAGED_V_FILES $STAGED_XML_FILES $STAGED_PY_FILES; do
    if [ -f "$file" ]; then
        if file "$file" | grep -q "CRLF"; then
            echo -e "${YELLOW}⚠ CRLF line endings in: $file (should be LF)${NC}"
            echo "  Run: dos2unix $file"
            CRLF_FAILED=1
            # Warning only, don't fail the commit
        fi
    fi
done

if [ $CRLF_FAILED -eq 0 ]; then
    echo -e "${GREEN}✓ All files use LF line endings${NC}"
fi

# ============================================================================
# Check 5: Python Syntax (if Python files staged)
# ============================================================================
if [ -n "$STAGED_PY_FILES" ]; then
    echo ""
    echo "🐍 Checking Python syntax..."
    # Try to find a working Python interpreter
    PYTHON_CMD=""
    for py_cmd in python3 python py; do
        if command -v "$py_cmd" &> /dev/null; then
            # Test if Python actually works (not just Windows app alias)
            if "$py_cmd" -c "import sys; sys.exit(0)" 2>/dev/null; then
                PYTHON_CMD="$py_cmd"
                break
            fi
        fi
    done

    if [ -n "$PYTHON_CMD" ]; then
        PYTHON_FAILED=0
        for file in $STAGED_PY_FILES; do
            if [ -f "$file" ]; then
                if ! "$PYTHON_CMD" -m py_compile "$file" 2>/dev/null; then
                    echo -e "${RED}✗ Python syntax error in: $file${NC}"
                    "$PYTHON_CMD" -m py_compile "$file" 2>&1 | head -10
                    PYTHON_FAILED=1
                    FAILED=1
                fi
            fi
        done
        if [ $PYTHON_FAILED -eq 0 ]; then
            echo -e "${GREEN}✓ Python syntax checks passed${NC}"
        fi
    else
        echo -e "${YELLOW}⚠ Python not found or not working (skipping Python checks)${NC}"
        echo "  Install Python or ensure it's in your PATH"
    fi
fi

# ============================================================================
# Check 6: XML Well-formedness
# ============================================================================
if [ -n "$STAGED_XML_FILES" ]; then
    echo ""
    echo "📋 Checking XML syntax..."
    if command -v xmllint &> /dev/null; then
        XML_FAILED=0
        for file in $STAGED_XML_FILES; do
            if [ -f "$file" ]; then
                if ! xmllint --noout "$file" 2>/dev/null; then
                    echo -e "${RED}✗ XML syntax error in: $file${NC}"
                    xmllint --noout "$file"
                    XML_FAILED=1
                    FAILED=1
                fi
            fi
        done
        if [ $XML_FAILED -eq 0 ]; then
            echo -e "${GREEN}✓ XML syntax checks passed${NC}"
        fi
    else
        echo -e "${YELLOW}⚠ xmllint not found (skipping XML checks)${NC}"
        echo "  Install: sudo apt-get install libxml2-utils"
    fi
fi

# ============================================================================
# Check 7: Large Files (>1MB)
# ============================================================================
echo ""
echo "📦 Checking for large files..."
LARGE_FILES=0
for file in $(git diff --cached --name-only --diff-filter=ACM | grep -v '^example_design/' | grep -v '^sim/' | grep -v '^testbench/' || true); do
    if [ -f "$file" ]; then
        size=$(stat -c%s "$file" 2>/dev/null || stat -f%z "$file" 2>/dev/null || echo 0)
        if [ "$size" -gt 1048576 ]; then  # 1MB
            echo -e "${YELLOW}⚠ Large file detected: $file ($(numfmt --to=iec-i --suffix=B $size))${NC}"
            LARGE_FILES=1
        fi
    fi
done

# Check tb_top files for size (only at root testbench/ level, not in example_design/)
for file in $(git diff --cached --name-only --diff-filter=ACM | grep -E '^testbench/tb_top\.(v|sv)$' || true); do
    if [ -f "$file" ]; then
        size=$(stat -c%s "$file" 2>/dev/null || stat -f%z "$file" 2>/dev/null || echo 0)
        if [ "$size" -gt 1048576 ]; then  # 1MB
            echo -e "${YELLOW}⚠ Large file detected: $file ($(numfmt --to=iec-i --suffix=B $size))${NC}"
            LARGE_FILES=1
        fi
    fi
done

if [ $LARGE_FILES -eq 0 ]; then
    echo -e "${GREEN}✓ No large files detected (example_design/, sim/, testbench/ excluded except tb_top.*)${NC}"
fi

# ============================================================================
# Final Result
# ============================================================================
echo ""
echo "========================================"
if [ $FAILED -eq 0 ]; then
    echo -e "${GREEN}✅ All pre-commit checks passed!${NC}"
    echo "========================================"
    exit 0
else
    echo -e "${RED}❌ Pre-commit checks failed!${NC}"
    echo "========================================"
    echo ""
    echo "Fix the issues above and try again."
    echo ""
    echo "To skip these checks (not recommended):"
    echo "  git commit --no-verify"
    echo ""
    exit 1
fi

