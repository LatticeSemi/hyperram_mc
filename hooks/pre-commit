#!/bin/bash
# Pre-commit hook for HyperRAM Memory Controller
# This hook runs before each commit to check code quality

set -e

# Color codes for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

echo "🔍 Running pre-commit checks..."

# Get list of staged files
STAGED_V_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(v|sv|vh|svh)$' || true)
STAGED_XML_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '\.xml$' || true)
STAGED_PY_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '\.py$' || true)

# Exit early if no relevant files
if [ -z "$STAGED_V_FILES" ] && [ -z "$STAGED_XML_FILES" ] && [ -z "$STAGED_PY_FILES" ]; then
    echo -e "${GREEN}✓ No Verilog, XML, or Python files to check${NC}"
    exit 0
fi

# Track if any checks failed
FAILED=0

# ============================================================================
# Check 1: Trailing Whitespace
# ============================================================================
echo ""
echo "📝 Checking for trailing whitespace..."
for file in $STAGED_V_FILES $STAGED_XML_FILES $STAGED_PY_FILES; do
    if [ -f "$file" ]; then
        if grep -qn '[[:space:]]$' "$file"; then
            echo -e "${RED}✗ Trailing whitespace found in: $file${NC}"
            grep -n '[[:space:]]$' "$file" | head -5
            FAILED=1
        fi
    fi
done

if [ $FAILED -eq 0 ]; then
    echo -e "${GREEN}✓ No trailing whitespace${NC}"
fi

# ============================================================================
# Check 2: Tab Characters (should use spaces)
# ============================================================================
echo ""
echo "📝 Checking for tab characters..."
TAB_FAILED=0
for file in $STAGED_V_FILES $STAGED_XML_FILES $STAGED_PY_FILES; do
    if [ -f "$file" ]; then
        if grep -qP '\t' "$file"; then
            echo -e "${RED}✗ Tab characters found in: $file (use spaces)${NC}"
            TAB_FAILED=1
            FAILED=1
        fi
    fi
done

if [ $TAB_FAILED -eq 0 ]; then
    echo -e "${GREEN}✓ No tab characters (spaces used correctly)${NC}"
fi

# ============================================================================
# Check 3: File Encoding (UTF-8)
# ============================================================================
echo ""
echo "📝 Checking file encoding..."
ENCODING_FAILED=0
for file in $STAGED_V_FILES $STAGED_XML_FILES $STAGED_PY_FILES; do
    if [ -f "$file" ]; then
        if command -v file &> /dev/null; then
            encoding=$(file -b --mime-encoding "$file")
            if [[ ! "$encoding" =~ ^(us-ascii|utf-8)$ ]]; then
                echo -e "${RED}✗ Non-UTF-8 encoding in: $file (found: $encoding)${NC}"
                ENCODING_FAILED=1
                FAILED=1
            fi
        fi
    fi
done

if [ $ENCODING_FAILED -eq 0 ]; then
    echo -e "${GREEN}✓ All files are UTF-8 or ASCII${NC}"
fi

# ============================================================================
# Check 4: Line Endings (LF not CRLF)
# ============================================================================
echo ""
echo "📝 Checking line endings (should be LF)..."
CRLF_FAILED=0
for file in $STAGED_V_FILES $STAGED_XML_FILES $STAGED_PY_FILES; do
    if [ -f "$file" ]; then
        if file "$file" | grep -q "CRLF"; then
            echo -e "${YELLOW}⚠ CRLF line endings in: $file (should be LF)${NC}"
            echo "  Run: dos2unix $file"
            CRLF_FAILED=1
            # Warning only, don't fail the commit
        fi
    fi
done

if [ $CRLF_FAILED -eq 0 ]; then
    echo -e "${GREEN}✓ All files use LF line endings${NC}"
fi

# ============================================================================
# Check 5: Python Syntax (if Python files staged)
# ============================================================================
if [ -n "$STAGED_PY_FILES" ]; then
    echo ""
    echo "🐍 Checking Python syntax..."
    if command -v python3 &> /dev/null; then
        PYTHON_FAILED=0
        for file in $STAGED_PY_FILES; do
            if [ -f "$file" ]; then
                if ! python3 -m py_compile "$file" 2>/dev/null; then
                    echo -e "${RED}✗ Python syntax error in: $file${NC}"
                    python3 -m py_compile "$file"
                    PYTHON_FAILED=1
                    FAILED=1
                fi
            fi
        done
        if [ $PYTHON_FAILED -eq 0 ]; then
            echo -e "${GREEN}✓ Python syntax checks passed${NC}"
        fi
    else
        echo -e "${YELLOW}⚠ Python not found (skipping Python checks)${NC}"
    fi
fi

# ============================================================================
# Check 6: XML Well-formedness
# ============================================================================
if [ -n "$STAGED_XML_FILES" ]; then
    echo ""
    echo "📋 Checking XML syntax..."
    if command -v xmllint &> /dev/null; then
        XML_FAILED=0
        for file in $STAGED_XML_FILES; do
            if [ -f "$file" ]; then
                if ! xmllint --noout "$file" 2>/dev/null; then
                    echo -e "${RED}✗ XML syntax error in: $file${NC}"
                    xmllint --noout "$file"
                    XML_FAILED=1
                    FAILED=1
                fi
            fi
        done
        if [ $XML_FAILED -eq 0 ]; then
            echo -e "${GREEN}✓ XML syntax checks passed${NC}"
        fi
    else
        echo -e "${YELLOW}⚠ xmllint not found (skipping XML checks)${NC}"
        echo "  Install: sudo apt-get install libxml2-utils"
    fi
fi

# ============================================================================
# Check 7: Large Files (>1MB)
# ============================================================================
echo ""
echo "📦 Checking for large files..."
LARGE_FILES=0
for file in $(git diff --cached --name-only --diff-filter=ACM); do
    if [ -f "$file" ]; then
        size=$(stat -c%s "$file" 2>/dev/null || stat -f%z "$file" 2>/dev/null || echo 0)
        if [ "$size" -gt 1048576 ]; then  # 1MB
            echo -e "${YELLOW}⚠ Large file detected: $file ($(numfmt --to=iec-i --suffix=B $size))${NC}"
            LARGE_FILES=1
        fi
    fi
done

if [ $LARGE_FILES -eq 0 ]; then
    echo -e "${GREEN}✓ No large files detected${NC}"
fi

# ============================================================================
# Final Result
# ============================================================================
echo ""
echo "========================================"
if [ $FAILED -eq 0 ]; then
    echo -e "${GREEN}✅ All pre-commit checks passed!${NC}"
    echo "========================================"
    exit 0
else
    echo -e "${RED}❌ Pre-commit checks failed!${NC}"
    echo "========================================"
    echo ""
    echo "Fix the issues above and try again."
    echo ""
    echo "To skip these checks (not recommended):"
    echo "  git commit --no-verify"
    echo ""
    exit 1
fi

