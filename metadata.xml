    <lsccip:settings>
        <lsccip:setting id="HYPERRAM_NUM"
                        type="param"
                        value_type="int"
                        conn_mod="hyperram_mc"
                        title="Number of Hyperram"
                        default="2"
                        options="[1, 2]"
                        editable="False"
                        group1="General"
         />
        <lsccip:setting id="ONE_RANK_EN"
                        type="param"
                        value_type="bool"
                        conn_mod="hyperram_mc"
                        title="Use multiple Hyperram chips as 1 rank"
                        default="True"
                        group1="General"
         />
        <lsccip:setting id="ID_W"
                        type="param"
                        value_type="int"
                        conn_mod="hyperram_mc"
                        title="ID Width"
                        default="1"
                        options="range(1,33)"
                        group1="General"
         />
        <lsccip:setting id="SYSBUS_CLOCK_MHZ"
                        type="param"
                        value_type="int"
                        conn_mod="hyperram_mc"
                        title="System Clock Frequency (MHZ)"
                        default="100"
                        value_range="(20, 200)"
                        group1="General"
                        group2="Timing Parameters"
         />
        <lsccip:setting id="TVCS_10US"
                        type="param"
                        value_type="int"
                        conn_mod="hyperram_mc"
                        title="power-up reset time (10us based)"
                        default="15"
                        group1="General"
                        group2="Timing Parameters"
         />
        <lsccip:setting id="INITIAL_LATENCY"
                        type="param"
                        value_type="int"
                        conn_mod="hyperram_mc"
                        title="INITIAL LATENCY"
                        default="0"
                        value_range="(0, 2)"
                        group1="General"
                        group2="Timing Parameters"
         />
        <lsccip:setting id="DELAY_HALF_CYCLE"
                        type="param"
                        value_type="bool"
                        conn_mod="hyperram_mc"
                        title="DELAY HALF CYCLE"
                        default="False"
                        group1="General"
                        group2="Timing Parameters"
         />
    </lsccip:settings>
