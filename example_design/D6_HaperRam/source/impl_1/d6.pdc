#ldc_set_location -site {G22} [get_ports s1_uart_rxd_i]
#ldc_set_location -site {H22} [get_ports s1_uart_txd_o]
#ldc_set_sysconfig {CONFIGURATION=CFGUFM CONFIG_IOSLEW=FAST BOOTMODE=SINGLE}
create_clock -name {osc0_inst_hf_clk_out_o} -period 20 -waveform {0.000 10.000} [get_pins osc0_inst/lscc_osc_inst/gen_osca.u_OSC_A.OSCA_inst/HFCLKOUT]
create_clock -name {osc0_inst_lf_clk_out_o} -period 31250 -waveform {0.000 15625.000} [get_pins osc0_inst/lscc_osc_inst/gen_osca.u_OSC_A.OSCA_inst/LFCLKOUT]
create_generated_clock -name {pll0_inst_clkop_o_net} -source [get_pins {pll0_inst/lscc_pll_inst/gen_no_refclk_mon.u_PLL.PLL_inst/REFCK}] -multiply_by 3 -divide_by 2 [get_pins {pll0_inst/lscc_pll_inst/gen_no_refclk_mon.u_PLL.PLL_inst/CLKOP }]
create_generated_clock -name {pll0_inst_clkos_o_net} -source [get_pins {pll0_inst/lscc_pll_inst/gen_no_refclk_mon.u_PLL.PLL_inst/REFCK}] -multiply_by 2 [get_pins {pll0_inst/lscc_pll_inst/gen_no_refclk_mon.u_PLL.PLL_inst/CLKOS }]
create_generated_clock -name {pll0_inst_clkos2_o_net} -source [get_pins {pll0_inst/lscc_pll_inst/gen_no_refclk_mon.u_PLL.PLL_inst/REFCK}] -multiply_by 2 [get_pins {pll0_inst/lscc_pll_inst/gen_no_refclk_mon.u_PLL.PLL_inst/CLKOS2 }]
set_false_path -from [get_clocks osc0_inst_lf_clk_out_o] -to [get_clocks pll0_inst_clkop_o_net]
set_false_path -from [get_clocks pll0_inst_clkop_o_net] -to [get_clocks osc0_inst_lf_clk_out_o]
