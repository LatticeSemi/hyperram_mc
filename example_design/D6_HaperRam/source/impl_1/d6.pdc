ldc_set_port -iobuf {DRIVE=16 SLEWRATE=FAST PULLMODE=UP} [get_ports {ram0_dq[0]}]
ldc_set_port -iobuf {DRIVE=16 SLEWRATE=FAST PULLMODE=UP} [get_ports {ram0_dq[1]}]
ldc_set_port -iobuf {DRIVE=16 SLEWRATE=FAST PULLMODE=UP} [get_ports {ram0_dq[2]}]
ldc_set_port -iobuf {DRIVE=16 SLEWRATE=FAST PULLMODE=UP} [get_ports {ram0_dq[3]}]
ldc_set_port -iobuf {DRIVE=16 SLEWRATE=FAST PULLMODE=UP} [get_ports {ram0_dq[4]}]
ldc_set_port -iobuf {DRIVE=16 SLEWRATE=FAST PULLMODE=UP} [get_ports {ram0_dq[5]}]
ldc_set_port -iobuf {DRIVE=16 SLEWRATE=FAST PULLMODE=UP} [get_ports {ram0_dq[6]}]
ldc_set_port -iobuf {DRIVE=16 SLEWRATE=FAST PULLMODE=UP} [get_ports {ram0_dq[7]}]
ldc_set_port -iobuf {DRIVE=16 SLEWRATE=FAST PULLMODE=UP} [get_ports {ram1_dq[0]}]
ldc_set_port -iobuf {DRIVE=16 SLEWRATE=FAST PULLMODE=UP} [get_ports {ram1_dq[1]}]
ldc_set_port -iobuf {DRIVE=16 SLEWRATE=FAST PULLMODE=UP} [get_ports {ram1_dq[2]}]
ldc_set_port -iobuf {DRIVE=16 SLEWRATE=FAST PULLMODE=UP} [get_ports {ram1_dq[3]}]
ldc_set_port -iobuf {DRIVE=16 SLEWRATE=FAST PULLMODE=UP} [get_ports {ram1_dq[4]}]
ldc_set_port -iobuf {DRIVE=16 SLEWRATE=FAST PULLMODE=UP} [get_ports {ram1_dq[5]}]
ldc_set_port -iobuf {DRIVE=16 SLEWRATE=FAST PULLMODE=UP} [get_ports {ram1_dq[6]}]
ldc_set_port -iobuf {DRIVE=16 SLEWRATE=FAST PULLMODE=UP} [get_ports {ram1_dq[7]}]
ldc_set_port -iobuf {DRIVE=16 SLEWRATE=FAST} [get_ports {ram0_ck_n[0]}]
ldc_set_port -iobuf {DRIVE=16 SLEWRATE=FAST} [get_ports {ram0_ck_p[0]}]
ldc_set_port -iobuf {DRIVE=16 SLEWRATE=FAST} [get_ports {ram0_cs[0]}]
ldc_set_port -iobuf {DRIVE=16 SLEWRATE=FAST} [get_ports {ram0_rst[0]}]
ldc_set_port -iobuf {DRIVE=16 SLEWRATE=FAST} [get_ports {ram0_rw[0]}]
