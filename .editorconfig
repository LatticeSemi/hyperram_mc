# EditorConfig for HyperRAM Memory Controller IP
# https://EditorConfig.org

# top-most EditorConfig file
root = true

# Default settings for all files
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# Verilog and SystemVerilog files
[*.{v,sv,vh,svh}]
indent_style = space
indent_size = 2
max_line_length = 100

# Python files (plugin scripts)
[*.py]
indent_style = space
indent_size = 4
max_line_length = 100

# XML files (metadata, bus_interface, memory_map, etc.)
[*.xml]
indent_style = space
indent_size = 4
max_line_length = 120

# C/C++ files
[*.{c,h,cpp,hpp}]
indent_style = space
indent_size = 4
max_line_length = 100

# HTML documentation
[*.html]
indent_style = space
indent_size = 2

# Markdown files (don't trim trailing whitespace - needed for line breaks)
[*.md]
trim_trailing_whitespace = false
indent_style = space
indent_size = 2
max_line_length = 80

# Makefile must use tabs
[Makefile]
indent_style = tab

# YAML files
[*.{yml,yaml}]
indent_style = space
indent_size = 2

# JSON files
[*.json]
indent_style = space
indent_size = 2

# Shell scripts
[*.{sh,bash}]
indent_style = space
indent_size = 2

# Tcl scripts
[*.tcl]
indent_style = space
indent_size = 2

