# Simulation working directories
**/sim/work/
**/sim/*.vcd
**/sim/*.log
work/

# Keep prebuilt libraries in sim/ (required for simulation)
# These should NOT be ignored:
# !sim/pmi/**
# !sim/lfmxo5/**
# !sim/uaplatform/**
# !sim/bht_ini.bin

# Synthesis and implementation outputs
**/syn/output/
**/syn/reports/
*.rpt
*.dcp

